# ─────────────────────────────────────────────────────────────────────────────
#  Sentinel SOC — environment file template
#
#  1. Copy this file:      cp .env.example .env          (Windows: copy .env.example .env)
#  2. Fill in what you need. EVERYTHING here is optional for local development:
#     with an empty .env the platform runs on Ollama + SQLite with no paid service.
#  3. Never commit .env — it is listed in .gitignore.
#
#  Non-secret settings (models, thresholds, agents…) live in backend/config/config.yaml.
#  The variables marked "override" below simply replace the matching YAML value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
# Required only when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
APP_ENV=development                 # override: app.environment (development | production)
DJANGO_DEBUG=false                  # true shows Django debug pages; never in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── API protection (recommended as soon as the API is reachable from other machines) ──
# When set, every API call needs "Authorization: Bearer <token>". The Next.js server adds it
# automatically, so the token never reaches the browser. Generate one like the secret key above.
SOC_API_TOKEN=

# ── Frontend → backend ───────────────────────────────────────────────────────
# Where the Next.js server finds Django (server-side only). docker-compose sets http://backend:8000.
BACKEND_URL=http://localhost:8000

# ── LLM provider (choose ONE; agents never change) ───────────────────────────
# ollama            = local & free (PRIMARY)            → no key needed, run `ollama serve`
# groq              = free tier with rate limits         → needs GROQ_API_KEY
# huggingface       = HF Inference Providers (free credits, then paid) → needs HF_TOKEN
# openai_compatible = LM Studio / vLLM / llama.cpp server → LLM_API_KEY only if your server needs one
# mock              = deterministic fake answers (tests / demos without any model)
# none              = LLM switched off; agents use rule/template fallbacks
LLM_PROVIDER=ollama                 # override: llm.provider
LLM_FALLBACK_PROVIDER=none          # override: llm.fallback_provider (e.g. groq)

# Ollama (override: llm.providers.ollama.*)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b                 # smaller machines: qwen3:4b, llama3.2:3b, gemma3:4b
 
# Groq — optional fallback. Free key: https://console.groq.com/keys
GROQ_API_KEY=
#GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face — optional. Token: https://huggingface.co/settings/tokens
# Also used (if set) when downloading the embedding model for RAG.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Any OpenAI-compatible server — optional
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_MODEL=local-model
LLM_API_KEY=

# ── Retrieval (RAG) ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # override: retrieval.embedding_model

# ── Database ─────────────────────────────────────────────────────────────────
# Only used when database.engine: postgres in config.yaml (default is SQLite, no setup).
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DATABASE_SSLMODE=prefer             # use "require" for hosted Postgres such as Supabase

# ── Twilio SMS (optional, paid service with a trial) ─────────────────────────
# Only used when notifications.twilio.enabled: true in config.yaml.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false                      # true = one JSON object per log line (always on in production)

# ── Advanced ─────────────────────────────────────────────────────────────────
# SOC_CONFIG_PATH=/path/to/another/config.yaml
